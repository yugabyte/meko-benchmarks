# Copy to .env at the repo root (gitignored).
# The Meko deployment under test (MCP endpoint and REST API).
MEKO_MCP_URL=http://127.0.0.1:8000/mcp
MEKO_API_URL=http://127.0.0.1:25433/api/v1
MEKO_AGENT_ID=meko

# Either a key you minted yourself...
MEKO_USER_TOKEN=
# ...or a login; the harness mints its own key (named "locomo-harness") and caches it in common/.token.
MEKO_EMAIL=
MEKO_PASSWORD=

# Answering model and judge run on OpenAI.
OPENAI_API_KEY=

# embed_turns.py only: the stack's YugabyteDB. Left unset, it uses this machine's own address on port 5433.
# MEKO_DB_URL=postgresql://yugabyte:yugabyte@<host YugabyteDB listens on>:5433/yugabyte
